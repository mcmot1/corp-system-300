# Generate DB_PASSWORD with: openssl rand -hex 24
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DOMAIN=tasks.example.com
CORS_ORIGINS=https://tasks.example.com
# Maximum members in one group conversation. This is not the number of employees.
MAX_CHAT_MEMBERS=500
# PostgreSQL connections for this API instance.
DB_POOL_MAX=20
